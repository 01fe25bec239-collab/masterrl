{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.masterrl.dev/provider/v1.schema.json",
  "title": "Provider v1",
  "description": "A user-connected AI provider. Keys live in the OS keychain; this document only names the keychain entry. Requests go straight from the user's machine to the provider.",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "type", "open_weight"],
  "properties": {
    "schema_version": { "const": "provider/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "display_name": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["openai_compatible", "anthropic", "gemini", "local_server", "masterrl_model", "custom_command"]
    },
    "base_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "api_key_ref": { "description": "Name of the OS keychain entry holding the key.", "type": "string", "minLength": 1 },
    "model_version_id": { "description": "For masterrl_model: the served model version.", "type": "string", "pattern": "^mv_[0-9A-Za-z-]+$" },
    "command": {
      "description": "For custom_command: reads the prompt on stdin, prints the answer; runs in the agent's sandbox profile for commands.",
      "type": "object",
      "required": ["argv", "timeout_s"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "additionalProperties": false
    },
    "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_weight": {
      "description": "true for open-weight or local models. false shows the terms-of-service notice before any use that creates training signal or data.",
      "type": "boolean"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_requests_per_minute": { "type": "integer", "minimum": 1 },
        "max_spend_per_run_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["openai_compatible", "local_server"] } } },
      "then": { "required": ["base_url"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["openai_compatible", "anthropic", "gemini"] } } },
      "then": { "required": ["api_key_ref"] }
    },
    {
      "if": { "properties": { "type": { "const": "masterrl_model" } } },
      "then": { "required": ["model_version_id"], "properties": { "open_weight": { "const": true } } }
    },
    {
      "if": { "properties": { "type": { "const": "custom_command" } } },
      "then": { "required": ["command"] }
    }
  ]
}

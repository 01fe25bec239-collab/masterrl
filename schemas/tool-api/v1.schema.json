{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.masterrl.dev/tool-api/v1.schema.json",
  "title": "Tool API v1",
  "description": "Typed tools mrl-server exposes to the AI Experimenter and over MCP. No shell, file system or network tools exist.",
  "type": "object",
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": { "const": "tool-api/v1" },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } }
  },
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "description", "risk", "input_schema", "output_schema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "risk": {
          "description": "read_only and plan: run without asking. compute: runs under Auto-review within budget, asks under Ask every time. important: always asks (budget overruns and deletions ask even under Full permission).",
          "enum": ["read_only", "plan", "compute", "important"]
        },
        "input_schema": { "description": "JSON Schema of the arguments.", "type": "object", "x-mrl-open": "a JSON Schema" },
        "output_schema": { "description": "JSON Schema of the result.", "type": "object", "x-mrl-open": "a JSON Schema" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.masterrl.dev/setup-profile/v1.schema.json",
  "title": "SetupProfile v1",
  "description": "The setup profile before it is encrypted on the device (XChaCha20-Poly1305, Argon2id key from the sync passphrase). Never holds secrets: no SSH keys, API keys or tokens.",
  "type": "object",
  "required": ["schema_version", "updated_at", "machines", "preferences"],
  "properties": {
    "schema_version": { "const": "setup-profile/v1" },
    "updated_at": { "type": "string", "format": "date-time" },
    "machines": { "type": "array", "items": { "$ref": "#/$defs/machine" } },
    "preferences": {
      "type": "object",
      "properties": {
        "theme": { "enum": ["system", "light", "dark"] },
        "language": { "description": "BCP 47 tag.", "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "experience": { "enum": ["beginner", "advanced"] },
        "default_machine": { "type": "string", "minLength": 1 },
        "notifications": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["team_id", "name", "role"],
        "properties": {
          "team_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["owner", "admin", "member", "viewer"] }
        },
        "additionalProperties": false
      }
    },
    "ui": { "description": "UI layout state (panels, column widths).", "type": "object", "x-mrl-open": "layout state owned by the app" }
  },
  "additionalProperties": false,
  "$defs": {
    "machine": {
      "type": "object",
      "required": ["id", "name", "transport"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "node_id": { "type": "string", "pattern": "^node_[0-9A-Za-z-]+$" },
        "transport": { "enum": ["direct", "ssh", "tailscale", "cloudflare_tunnel"] },
        "address": { "description": "host or host:port.", "type": "string", "minLength": 1 },
        "ssh": {
          "description": "The key itself stays in the keychain or SSH agent.",
          "type": "object",
          "required": ["host"],
          "properties": {
            "host": { "description": "Host name or a Host alias from ~/.ssh/config.", "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "user": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "tunnel_hostname": { "type": "string", "minLength": 1 },
        "wsl2": { "description": "The agent runs inside WSL2.", "type": "boolean" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "transport": { "const": "ssh" } } }, "then": { "required": ["ssh"] } },
        { "if": { "properties": { "transport": { "enum": ["direct", "tailscale"] } } }, "then": { "required": ["address"] } },
        { "if": { "properties": { "transport": { "const": "cloudflare_tunnel" } } }, "then": { "required": ["tunnel_hostname"] } }
      ]
    }
  }
}

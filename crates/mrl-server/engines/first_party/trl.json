                "group": "lora",
                "help": "Layers that get an adapter.",
                "order": 4,
                "tier": "expert"
              }
            }
          },
          "title": "LoraSettings",
          "type": "object"
        },
        "SftEngine": {
          "additionalProperties": false,
          "description": "`sft`: conversations (sft.messages.v1) or prompt/completion (sft.prompt_completion.v1).",
          "properties": {
            "assistant_only_loss": {
              "default": true,
              "title": "Assistant Only Loss",
              "type": "boolean",
              "x-mrl-ui": {
                "group": "loss",
                "help": "Conversations: learn only the assistant's turns.",
                "order": 2,
                "tier": "advanced"
              }
            },
            "completion_only_loss": {
              "default": true,
              "title": "Completion Only Loss",
              "type": "boolean",
              "x-mrl-ui": {
                "group": "loss",
                "help": "Prompt/completion: learn only the completion.",
                "order": 3,
                "tier": "advanced"
              }
            },
            "gradient_accumulation_steps": {
              "default": 1,
              "maximum": 4096,
              "minimum": 1,
              "title": "Gradient Accumulation Steps",
              "type": "integer",
              "x-mrl-ui": {
                "group": "batch",
                "help": "Steps summed before an update.",
                "order": 2,
                "tier": "advanced"
              }
            },
            "gradient_checkpointing": {
              "default": false,
              "title": "Gradient Checkpointing",
              "type": "boolean",
              "x-mrl-ui": {
                "group": "memory",
                "help": "Less memory, about 30% slower.",
                "order": 1,
                "tier": "advanced"
              }
            },
            "learning_rate": {
              "default": 0.0001,
              "exclusiveMinimum": 0,
              "maximum": 1,
              "title": "Learning Rate",
              "type": "number",
              "x-mrl-ui": {

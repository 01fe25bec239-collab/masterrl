              "default": {
                "lora": {
                  "alpha": 32.0,
                  "dropout": 0.05,
                  "r": 16,
                  "target_modules": "all-linear"
                },
                "strategy": "lora"
              }
            }
          },
          "title": "CommonBlock",
          "type": "object"
        },
        "LoraSettings": {
          "additionalProperties": false,
          "description": "LoRA adapter shape. Used by the `lora` and `qlora` strategies.",

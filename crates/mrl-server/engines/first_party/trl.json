              "title": "R",
              "type": "integer",
              "x-mrl-ui": {
                "group": "lora",
                "help": "Adapter rank.",
                "order": 1,
                "tier": "advanced"
              }
            },
            "target_modules": {
              "anyOf": [
                {
                  "const": "all-linear",
                  "type": "string"
                },
                {
                  "items": {
                    "pattern": "^[A-Za-z0-9_.]{1,128}$",

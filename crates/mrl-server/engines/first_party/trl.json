              "title": "Precision",
              "type": "string",
              "x-mrl-ui": {
                "group": "run",
                "help": "auto: bf16 on GPUs that support it, else fp16 or fp32.",
                "order": 2,
                "tier": "advanced"
              }
            },
            "seed": {
              "default": 0,
              "maximum": 4294967295,
              "minimum": 0,
              "title": "Seed",
              "type": "integer",

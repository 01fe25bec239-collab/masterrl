                "tier": "expert"
              }
            },
            "packing": {
              "default": false,
              "title": "Packing",
              "type": "boolean",
              "x-mrl-ui": {
                "group": "data",
                "help": "Pack short examples together.",
                "order": 2,
                "tier": "advanced"
              }
            },
            "per_device_train_batch_size": {
              "default": 4,
              "maximum": 4096,
              "minimum": 1,
              "title": "Per Device Train Batch Size",
              "type": "integer",
              "x-mrl-ui": {
                "group": "batch",
                "help": "Examples per step per GPU.",
                "order": 1,
                "tier": "advanced"
              }
            },
            "samples_every": {
              "default": 0,
              "maximum": 10000000,
              "minimum": 0,
              "title": "Samples Every",
              "type": "integer",
              "x-mrl-ui": {
                "group": "checkpoints",
                "help": "Steps between sample answers (0: off).",
                "order": 3,
                "tier": "advanced"
              }
            },
            "save_steps": {
              "default": 500,
              "maximum": 10000000,
              "minimum": 1,
              "title": "Save Steps",
              "type": "integer",
              "x-mrl-ui": {
                "group": "checkpoints",
                "help": "Steps between checkpoints.",
                "order": 1,
                "tier": "advanced"
              }
            },
            "warmup_ratio": {
              "default": 0.03,

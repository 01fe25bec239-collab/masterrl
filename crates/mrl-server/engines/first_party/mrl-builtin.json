{
  "dev_only": false,
  "kind": "builtin",
  "manifest": {
    "apiVersion": "mrl.dev/builtin/v1",
    "kind": "BuiltinManifest",
    "metadata": {
      "displayName": "Built-in utilities",
      "license": "Apache-2.0",
      "name": "mrl-builtin",
      "version": "0.1.0"
    },
    "spec": {
      "adapter": {
        "adapterApi": ">=1.0,<2",

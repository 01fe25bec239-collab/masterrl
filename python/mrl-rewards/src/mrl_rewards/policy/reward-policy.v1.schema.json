{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.masterrl.dev/reward-policy/v1.schema.json",
  "title": "RewardPolicy v1",
  "description": "How reward components combine into the reward the engine sees. The content of a RewardVersion. Failed samples are masked, given a declared fallback, or fail the batch: never a silent 0.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mrl.dev/reward/v1" },
    "kind": { "const": "RewardPolicy" },
    "metadata": {
      "type": "object",
      "required": ["name", "signal"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "description": { "type": "string" },
        "signal": { "enum": ["scalar.sequence", "scalar.step"] },
        "intended_algorithms": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "intended_schemas": { "type": "array", "items": { "enum": ["rl.prompt.v1", "agent.multiturn.v1"] } }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["components", "aggregation", "failure", "tests"],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "gates": {
          "description": "Hard constraints checked before aggregation; a failed gate sets the final reward to else_value and flags the sample gated.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "require", "else_value"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "require": { "description": "Condition over components.<id>.value / .diagnostics.", "type": "string", "minLength": 1 },
              "else_value": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "aggregation": {
          "type": "object",
          "required": ["method", "where"],
          "properties": {
            "method": { "enum": ["weighted_sum", "product", "min"] },
            "where": { "description": "platform: one scalar to the engine; engine: per-component pass-through.", "enum": ["platform", "engine"] }
          },
          "additionalProperties": false
        },
        "normalization": {
          "type": "object",
          "properties": {
            "per_component": { "$ref": "#/$defs/normalization" },
            "final": { "$ref": "#/$defs/normalization" }
          },
          "additionalProperties": false
        },
        "clipping": {
          "type": "object",
          "required": ["min", "max"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } },
          "additionalProperties": false
        },
        "shaping": {
          "description": "Declared dependence on trainer step (curriculum), so rewards are reproducible.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "component", "schedule"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "component": { "description": "Component id whose weight is scheduled.", "$ref": "#/$defs/slug" },
              "schedule": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["from_step", "weight"],
                  "properties": {
                    "from_step": { "type": "integer", "minimum": 0 },
                    "weight": { "type": "number" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "failure": {
          "type": "object",
          "required": ["on_timeout", "on_error", "max_failure_rate"],
          "properties": {
            "on_timeout": { "$ref": "#/$defs/failureAction" },
            "on_error": { "$ref": "#/$defs/failureAction" },
            "max_failure_rate": { "description": "Per batch; above it the batch fails.", "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "tests": { "description": "Path to the test cases, required before publish.", "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$" },
    "normalization": { "enum": ["none", "minmax", "zscore_running", "rank_in_group"] },
    "component": {
      "type": "object",
      "required": ["id", "use", "weight"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "use": {
          "description": "Registry reference <namespace>/<name>@<major>, e.g. builtin/math.verify@1.",
          "type": "string",
          "pattern": "^(builtin|hub|org|judge)/[a-z0-9][a-z0-9._-]*@[0-9]+$"
        },
        "params": { "type": "object", "x-mrl-open": "params are defined by each component" },
        "weight": { "type": "number" },
        "range": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "when": { "description": "Condition; when false the component is NOT_APPLICABLE.", "type": "string" }
      },
      "additionalProperties": false
    },
    "failureAction": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["mask", "fallback", "fail_batch"] },
        "fallback_value": { "type": ["number", "null"] }
      },
      "additionalProperties": false,
      "if": { "properties": { "action": { "const": "fallback" } } },
      "then": { "required": ["fallback_value"], "properties": { "fallback_value": { "type": "number" } } }
    }
  }
}

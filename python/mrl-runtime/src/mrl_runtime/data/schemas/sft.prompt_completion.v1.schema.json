{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.masterrl.dev/datasets/sft.prompt_completion.v1.schema.json",
  "title": "sft.prompt_completion.v1",
  "description": "Supervised fine-tuning on prompt/completion pairs; the loss covers the completion only.",
  "type": "object",
  "required": ["prompt", "completion"],
  "properties": {
    "prompt": { "$ref": "common.v1.schema.json#/$defs/textOrMessages" },
    "completion": { "$ref": "common.v1.schema.json#/$defs/textOrMessages" },
    "meta": { "$ref": "common.v1.schema.json#/$defs/meta" }
  },
  "additionalProperties": false
}

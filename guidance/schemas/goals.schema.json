{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal cards",
  "description": "What the user wants, mapped to candidate recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goals"],
  "properties": {
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "recipes", "dataset_schema", "reward_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "recipes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Recipe ids, best first."
          },
          "dataset_schema": {
            "enum": ["chat", "question-answer", "preference-pairs", "prompt-with-answer", "prompts"]
          },
          "reward_type": { "enum": ["none", "preference", "verifiable", "teacher"] }
        }
      }
    }
  }
}
